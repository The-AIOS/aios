{
  "contract": 5,
  "status": "draft",
  "how_to_run": "For each case, decide `request` with the surface's open decision, using `fs` as the file system, `roots` as the surface's roots and `home` as the home folder; the request file is `age_ms` old, and `recent` lists the opens this surface already performed (who asked, which resolved path, how long ago). Compare with `expect`: {do: open, path, mode, line?} or {do: refuse, why}. Paths are POSIX. An `fs` entry is a regular file (with `class`: text, asset, binary or large, and `executable`), a directory, or a symbolic link (`to`, absolute). A folder that holds an entry exists even when it is not listed.",
  "constants": {
    "max_age_ms": 60000,
    "rate_max": 5,
    "rate_window_ms": 60000,
    "max_line": 10000000
  },
  "home": "/home/op",
  "roots": [
    "/home/op/aios",
    "/home/op/rootlink"
  ],
  "fs": {
    "/home/op/aios/vault/note.md": {
      "kind": "file",
      "class": "text"
    },
    "/home/op/aios/vault/page.html": {
      "kind": "file",
      "class": "text"
    },
    "/home/op/aios/vault/Report.HTM": {
      "kind": "file",
      "class": "text"
    },
    "/home/op/aios/vault/pic.png": {
      "kind": "file",
      "class": "asset"
    },
    "/home/op/aios/vault/doc.pdf": {
      "kind": "file",
      "class": "asset"
    },
    "/home/op/aios/vault/big.log": {
      "kind": "file",
      "class": "large"
    },
    "/home/op/aios/vault/tool.bin": {
      "kind": "file",
      "class": "binary"
    },
    "/home/op/aios/hooks/run.sh": {
      "kind": "file",
      "class": "text",
      "executable": true
    },
    "/home/op/aios/vault/setup.ps1": {
      "kind": "file",
      "class": "text"
    },
    "/home/op/aios/vault/folder": {
      "kind": "dir"
    },
    "/home/op/aios/vault/link-out.md": {
      "kind": "symlink",
      "to": "/home/op/notes/out.md"
    },
    "/home/op/notes/out.md": {
      "kind": "file",
      "class": "text"
    },
    "/home/op/aios/vault/link-in.md": {
      "kind": "symlink",
      "to": "/home/op/work/repo/README.md"
    },
    "/home/op/work/repo/README.md": {
      "kind": "file",
      "class": "text"
    },
    "/home/op/aios/vault/key-link.md": {
      "kind": "symlink",
      "to": "/home/op/.ssh/id_ed25519"
    },
    "/home/op/.ssh/id_ed25519": {
      "kind": "file",
      "class": "text"
    },
    "/home/op/aios/vault/innocent.md": {
      "kind": "symlink",
      "to": "/home/op/work/repo/.env"
    },
    "/home/op/work/repo/.env": {
      "kind": "file",
      "class": "text"
    },
    "/home/op/work/repo/.env.example": {
      "kind": "file",
      "class": "text"
    },
    "/home/op/work/repo/server.pem": {
      "kind": "file",
      "class": "text"
    },
    "/home/op/work/repo/id_ed25519.pub": {
      "kind": "file",
      "class": "text"
    },
    "/home/op/work/repo/id_ed25519_sk": {
      "kind": "file",
      "class": "text"
    },
    "/home/op/work/repo/id_card.md": {
      "kind": "file",
      "class": "text"
    },
    "/home/op/aios/vault/agent-secrets/notes.md": {
      "kind": "file",
      "class": "text"
    },
    "/home/op/aios/vault/.ssh-notes.md": {
      "kind": "file",
      "class": "text"
    },
    "/home/op/aios/vault/Secret.ENV": {
      "kind": "file",
      "class": "text"
    },
    "/home/op/aios/vault/.Env": {
      "kind": "file",
      "class": "text"
    },
    "/home/op/work/linked": {
      "kind": "symlink",
      "to": "/home/op/aios/vault"
    },
    "/home/op/rootlink": {
      "kind": "symlink",
      "to": "/home/op/work"
    },
    "/home/op/aios-other/x.md": {
      "kind": "file",
      "class": "text"
    },
    "/home/op/aios/vault/loop-a": {
      "kind": "symlink",
      "to": "/home/op/aios/vault/loop-b"
    },
    "/home/op/aios/vault/loop-b": {
      "kind": "symlink",
      "to": "/home/op/aios/vault/loop-a"
    }
  },
  "cases": [
