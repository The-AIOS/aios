#!/usr/bin/env bash
# aios-commit — the ONLY sanctioned commit path in an AIOS repo that is written
# concurrently by the human (through Obsidian) + many agent sessions + scheduled routines.
#
# WHY IT EXISTS
#   `git add -A && git commit` encodes a single-writer assumption ("everything dirty is
#   mine") that is false the moment two actors share the working tree: whoever commits
#   first sweeps everyone else's in-flight files into ITS commit. No data is lost, but
#   attribution/blame/audit is scrambled. aios-commit fixes it STRUCTURALLY (poka-yoke) —
#   no per-actor discipline required, because the broad commit is made impossible:
#     • per-repo mkdir mutex (macOS ships no flock) w/ dead-holder reclaim → serialises commits
#     • stages ONLY the given paths (never `git add -A`) → kills the cross-sweep race
#     • builds the commit from a THROWAWAY INDEX via plumbing (read-tree → add → write-tree →
#       commit-tree → update-ref): THE WORKING TREE IS NEVER TOUCHED, so Obsidian's live copy
#       is never disturbed and there is no dirty-tree rebase hazard
#     • self-scans for secrets (plumbing skips the pre-commit hook, so aios-commit scans itself)
#     • push-retry: on a failed push it KEEPS THE COMMIT LOCAL → never orphans, never loses.
#       The failure is CLASSIFIED (blocked egress · offline · diverged · auth) because only
#       some causes self-heal on the next run; a persistent one gets the action to take, plus
#       a .git/aios-push-pending marker the close rituals sweep.
#
# USAGE
#   aios-commit -m "message" [--no-push] [--] <path> [<path> ...]
#   aios-commit -m "message" --vault [--no-push]
#   aios-commit -m "message" --untrack <path> [--untrack <path>] [--] [<path> ...]
#     --untrack records a path's REMOVAL from tracking while LEAVING THE FILE ON DISK — the
#     "I just gitignored something that was already tracked" case. `git add` cannot express it
#     (it stages what the working tree has, so a file that still exists gets re-added; and once
#     the path is ignored git refuses to add it at all), which used to force a raw `git commit`
#     past the attribution guard. Combine freely with normal paths: a typical call commits the
#     .gitignore edit AND the untrack in one commit.
#     --vault sweeps the changed vault paths for you (space- AND rename-safe: it enumerates
#     `git diff --name-only HEAD` ∪ untracked under vault/ + .aios-update, minus machine-local
#     noise) — so callers never hand-roll a `git status | awk` sweep that truncates paths with
#     spaces ("00 - notes"). This is the sanctioned "commit the session's vault work" invocation.
#
# Design contributed by an AIOS operator (2026-06-21), de-personalized + built into core.
set -uo pipefail

die(){ echo "aios-commit: $*" >&2; exit 1; }

MSG=""; NO_PUSH=0; VAULT_MODE=0; PATHS=(); UNTRACK=()
while [ $# -gt 0 ]; do
  case "$1" in
    -m)   MSG="${2:-}"; shift 2 ;;
    -m*)  MSG="${1#-m}"; shift ;;
    --no-push) NO_PUSH=1; shift ;;
    --vault) VAULT_MODE=1; shift ;;
    # --untrack: record a path's REMOVAL from tracking while leaving the file on disk.
    # `git add` cannot express this — it stages what the WORKING TREE has, so a file that
    # still exists gets re-added, and once the path is gitignored git refuses to add it at
    # all ("use -f if you really want to"). That made "gitignore something already tracked"
    # impossible through the one sanctioned commit path, forcing a raw `git commit`.
    # Repeatable. Operates on the throwaway index only — the working tree is never touched.
    --untrack) [ -n "${2:-}" ] || die "--untrack needs a path"; UNTRACK+=("$2"); shift 2 ;;
    --)   shift; while [ $# -gt 0 ]; do PATHS+=("$1"); shift; done ;;
    *)    PATHS+=("$1"); shift ;;
  esac
done
[ -n "$MSG" ] || die "need -m <message>"
# --vault populates PATHS from the scoped sweep (below, under the lock). Otherwise ≥1 explicit
# path is required — aios-commit NEVER stages -A (that is the bug it prevents).
[ "$VAULT_MODE" = 1 ] || [ ${#PATHS[@]} -gt 0 ] || [ ${#UNTRACK[@]} -gt 0 ] || die "need at least one path (or --vault / --untrack) — aios-commit never stages -A"

git rev-parse --git-dir >/dev/null 2>&1 || die "not inside a git repo"
GIT_DIR=$(git rev-parse --absolute-git-dir)
TOPLEVEL=$(git rev-parse --show-toplevel)
cd "$TOPLEVEL" || die "cannot cd to repo root"

# ── pending-push sweep: recover commits an EARLIER run could not push ──
# Deliberately placed BEFORE the "nothing to commit" early-exits below, because
# those exits are exactly how a stranded commit stayed stranded: they never reach
# the push at the end of this script. Every aios-commit invocation is therefore a
# sweep point, whether or not it has anything of its own to commit.
# Costs a single stat when nothing is pending.
PENDING="$GIT_DIR/aios-push-pending"
if [ "$NO_PUSH" != 1 ] && [ -f "$PENDING" ] \
   && git remote | grep -q . && git symbolic-ref --short HEAD >/dev/null 2>&1; then
  SWEEP_N=$(git rev-list --count @{u}..HEAD 2>/dev/null || echo '?')
  if git push -q 2>/dev/null; then
    rm -f "$PENDING"
    echo "aios-commit: swept a pending push from an earlier run — $SWEEP_N commit(s) now on the remote."
  fi
  # Still blocked → keep the marker. If this run commits, the push at the end
  # reports the classified cause; if it exits early, the next invocation retries.
fi

# ── per-repo mutex: mkdir is atomic; a stale lock from a dead holder is reclaimed ──
LOCK="$GIT_DIR/aios-commit.lock"
acquire(){
  local tries=0 holder saw_lock=0
  while ! mkdir "$LOCK" 2>/dev/null; do
    # mkdir fails for two unrelated reasons and only one is contention:
    #   EEXIST        → somebody holds it. Retrying is right.
    #   EACCES/ENOENT → we can never create it (unwritable $GIT_DIR — a sandboxed
    #                   Bash tool, a read-only checkout — or a non-dir squatting
    #                   on the lock path). Retrying cannot help.
    # Distinguish by OBSERVATION, not by parsing mkdir's stderr: those strings are
    # locale-dependent, and a check that knows only one spelling of what it forbids
    # is not a check. `saw_lock` is sticky — one sighting of a real lock directory
    # means every later failure is treated as contention forever after, so a holder
    # that releases mid-loop can never be misread as a permission fault.
    if [ -d "$LOCK" ]; then
      saw_lock=1
      holder=$(cat "$LOCK/pid" 2>/dev/null || true)
      if [ -n "$holder" ] && ! kill -0 "$holder" 2>/dev/null; then
        rm -rf "$LOCK" 2>/dev/null; continue      # dead holder → reclaim
      fi
    else
      holder=""
    fi
    tries=$((tries+1))
    # Never observed a lock across 20 consecutive failures (~2s) → not contention.
    # Fail now with the real cause instead of spinning 60s and then blaming a pid
    # that never existed.
    if [ "$saw_lock" -eq 0 ] && [ "$tries" -ge 20 ]; then
      die "cannot create $LOCK — $tries attempts, no lock ever present: this is NOT contention. $GIT_DIR is likely not writable (sandboxed session? read-only checkout?), or a non-directory occupies the lock path."
    fi
    [ "$tries" -gt 600 ] && die "lock timeout (held by pid ${holder:-unknown})"
    sleep 0.1
  done
  echo "$$" > "$LOCK/pid"
}
LOCKED=0
release(){ [ "$LOCKED" = 1 ] && { rm -rf "$LOCK" 2>/dev/null; LOCKED=0; }; }
TMPIDX=""
cleanup(){ [ -n "$TMPIDX" ] && rm -f "$TMPIDX"; release; }
trap cleanup EXIT
acquire; LOCKED=1

# ── --vault: build PATHS from the scoped vault sweep, under the lock so it's atomic vs a sibling
#    commit. Space-safe (core.quotePath=false + one path per line, read into an array) and
#    rename-safe (diff --name-only yields the new path). Union of tracked-changed-vs-HEAD +
#    untracked (gitignore-respecting) under vault/ + .aios-update, minus machine-local noise. ──
if [ "$VAULT_MODE" = 1 ]; then
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    case "$p" in
      .glass/*|vault/.obsidian/workspace.json|vault/.obsidian/workspace-mobile.json) continue ;;
    esac
    PATHS+=("$p")
  done < <( { git -c core.quotePath=false diff --name-only HEAD -- 'vault/' '.aios-update' 2>/dev/null
              git -c core.quotePath=false ls-files --others --exclude-standard -- 'vault/' '.aios-update' 2>/dev/null; } | sort -u )
  if [ ${#PATHS[@]} -eq 0 ]; then
    # "THERE IS NOTHING" AND "THERE IS SOMETHING I CANNOT EXPLAIN" MUST NOT PRINT THE SAME LINE.
    #
    # The sweep above reads the WORKING TREE against HEAD. `git status` reads the REAL INDEX. When
    # that index has drifted, both are truthful and they contradict each other: status shows a path
    # as modified, the sweep correctly finds nothing differing from HEAD, and the old message —
    # "no vault changes to commit" — asserted something stronger than it had measured. From the
    # outside that is indistinguishable from a sweep whose pathspec cannot reach the file, which is
    # exactly how an operator once spent a session hunting a sweep bug that did not exist. (The
    # sweep was byte-identical across the versions involved; verified by diffing them.)
    #
    # This deliberately does NOT try to detect a desynced index or explain why. It only notices
    # that two reads of the same repo disagree, and says so — which is the cheap half of the
    # problem and the half that is always available. Credit where due: an operator proposed this
    # shape after measuring that the fix he had originally suggested addressed the wrong layer.
    #
    # SAME SCOPE, SAME EXCLUSIONS as the sweep above, on purpose. Comparing two reads taken over
    # DIFFERENT path sets would itself be a measurement mismatch, and would fire this warning on
    # machine-local noise that `--vault` is designed to ignore.
    N_STATUS=0
    while IFS= read -r sp; do
      [ -n "$sp" ] || continue
      case "$sp" in
        .glass/*|vault/.obsidian/workspace.json|vault/.obsidian/workspace-mobile.json) continue ;;
      esac
      N_STATUS=$((N_STATUS + 1))
    done < <(git -c core.quotePath=false status --porcelain -- 'vault/' '.aios-update' 2>/dev/null \
             | sed 's/^...//; s/^.* -> //')
    if [ "$N_STATUS" -gt 0 ]; then
      echo "aios-commit: status shows $N_STATUS path(s) under vault/ that do not differ from HEAD."
      echo "  Two reads of this repo disagree, so nothing was committed rather than guessing."
      echo "  Your real index may be desynced — \`git reset\` fixes it and keeps your working tree."
      # Exit 0, not non-zero, and the reason is a real tradeoff rather than an oversight: this
      # command did not FAIL, it correctly declined to commit. `--vault` is called mid-ritual by
      # /close-session, /close-day and /aios:update, and a non-zero here would abort those chains
      # over a cosmetic index state. The message is the deliverable; the exit code stays honest
      # about what happened, which is "nothing, on purpose".
      exit 0
    fi
    echo "aios-commit: no vault changes to commit."
    exit 0
  fi
fi

# ── secret self-scan (plumbing bypasses the pre-commit hook, so scan here) ──
# Scan only PATHS — never UNTRACK. An untracked path's content is leaving the repo, not
# entering it, and it may be gitignored or unreadable; scanning it could block a removal.
SCAN="$(cd "$(dirname "$0")" && pwd)/git/secret-scan.sh"
if [ -x "$SCAN" ] && [ ${#PATHS[@]} -gt 0 ]; then
  "$SCAN" "${PATHS[@]}" || die "secret scan blocked the commit (see the finding above)"
fi

# ── build the commit from a throwaway index — the working tree is NEVER touched ──
TMPIDX=$(mktemp "${TMPDIR:-/tmp}/aios-commit-idx.XXXXXX")
if git rev-parse -q --verify HEAD >/dev/null 2>&1; then
  GIT_INDEX_FILE="$TMPIDX" git read-tree HEAD
  PARENTS=(-p HEAD)
else
  GIT_INDEX_FILE="$TMPIDX" git read-tree --empty
  PARENTS=()
fi

# stage ONLY the given paths into the temp index (adds · modifications · deletions)
if [ ${#PATHS[@]} -gt 0 ]; then
  GIT_INDEX_FILE="$TMPIDX" git add --all -- "${PATHS[@]}" || die "failed to stage the given paths"
fi

# --untrack paths: drop them from the temp index so the commit records a REMOVAL, while the
# file stays on disk. --cached is what keeps the working tree untouched; --ignore-unmatch makes
# it idempotent (re-running on an already-untracked path is a no-op, caught by the guard below).
if [ ${#UNTRACK[@]} -gt 0 ]; then
  GIT_INDEX_FILE="$TMPIDX" git rm --cached -rf --quiet --ignore-unmatch -- "${UNTRACK[@]}" \
    || die "failed to untrack the given paths"
fi

# no-op guard: paths given but nothing actually changed vs HEAD.
# --cached is LOAD-BEARING: without it, diff-index compares HEAD against the WORKING TREE
# (the temp index has a zeroed stat cache from read-tree, so git content-scans every tracked
# file) — and any unrelated dirty file in the tree (Obsidian always leaves one) makes the guard
# miss the no-op and write an EMPTY commit. --cached compares the temp index to HEAD directly.
if [ "${#PARENTS[@]}" -gt 0 ] && GIT_INDEX_FILE="$TMPIDX" git diff-index --quiet --cached HEAD --; then
  echo "aios-commit: no changes in the given paths — nothing to commit."
  exit 0
fi

TREE=$(GIT_INDEX_FILE="$TMPIDX" git write-tree) || die "write-tree failed"

# ── session provenance trailer ────────────────────────────────────────────────
# WHY: a vault is written CONCURRENTLY by several Claude sessions, and git cannot
# tell them apart — same author, same committer, no distinguishing field. Anything
# that needs to ask "did *I* do this?" has been forced to infer it from the commit
# SUBJECT, which is a convention, not a fact. /close-session's duplicate detector
# was the first consumer to hit the limit: it counts commits that are not its own
# close-bookkeeping, so a PEER's commit reads as "this session did work" and a
# spurious re-fire appends a duplicate block anyway. Measured 2026-08-13: 10
# non-close commits since one session's stamp, only 1 of them its own.
# Record the provenance instead of inferring it. Additive: an empty CLAUDE_CODE_SESSION_ID
# (a human at a terminal, a script, an older Claude) simply omits the trailer, and every
# consumer MUST treat "no trailer" as unknown-not-mine and degrade to its old behaviour.
if [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then
  case "$CLAUDE_CODE_SESSION_ID" in
    *[!a-zA-Z0-9-]*) : ;;    # refuse anything that could forge a trailer line
    *) MSG="$MSG

AIOS-Session: $CLAUDE_CODE_SESSION_ID" ;;
  esac
fi

# ${PARENTS[@]+"${PARENTS[@]}"} — PARENTS is EMPTY on a root commit (no HEAD yet), and bash 3.2
# (the macOS system bash) treats "${arr[@]}" on an empty array as unbound under `set -u` → the
# very first commit in a fresh repo aborts. The +alternate form is empty-safe on 3.2 and 4+.
COMMIT=$(git commit-tree "$TREE" ${PARENTS[@]+"${PARENTS[@]}"} -m "$MSG") || die "commit-tree failed"
git update-ref HEAD "$COMMIT" || die "update-ref failed"

# sync the REAL index for the committed paths only → `git status` shows them clean;
# every other actor's in-flight file is left exactly as it was.
#
# The emptiness guard is LOAD-BEARING, not defensive: `git add --all --` with NO pathspec
# stages the ENTIRE tree (measured: 2/2 files in a scratch repo). On an --untrack-only
# invocation PATHS is empty, so an unguarded line here would be a literal `git add -A` on
# the shared index — the precise failure this whole tool exists to prevent, reintroduced by
# the flag that was meant to close a gap.
#
# ONE PATH PER CALL, deliberately — `git add --all -- a b c` is ALL-OR-NOTHING. If any single
# pathspec matches nothing in either the worktree or the index, git exits 128 ("fatal: pathspec
# 'X' did not match any files") and stages NONE of the others. That is not a corner case: it
# fires on the ordinary `git mv old new` flow, where the caller naturally passes BOTH names —
# `old` is gone from the worktree and already removed from the index by the mv, so it matches
# nothing and the entire sync is skipped. Combined with the swallowed error below, the failure
# was invisible in the worst way: commit and push both succeed, HEAD carries the new content,
# and the real index keeps the OLD content — so `git status` reports `MM` indefinitely and reads
# as unpushed work that does not exist. Measured on three repos 2026-07-30. Per-path, one dead
# pathspec costs only itself.
#
# THE FAILURE IS NOW REPORTED, because the comment above describes a symptom that
# is invisible by construction: `2>/dev/null` discarded git's message and `|| true`
# discarded its exit code, so a sync that did not happen looked exactly like one
# that did. That silence has a cost measured on 2026-08-27 — a stale real-index
# entry was found for a committed path, and by the time anyone looked, WHY the sync
# missed it was unrecoverable. Two hypotheses were tested and both falsified; the
# cause remains unknown, and it is unknown *because nothing recorded the failure at
# the moment it happened*.
#
# Still non-fatal, deliberately: the commit has already succeeded by this point, and
# failing here would turn a cosmetic index staleness into a hard error on work that
# is safely committed and pushed. But non-fatal is not the same as unmentioned. One
# line to stderr converts an unmeasurable failure into a measurable one, which is
# the whole difference between this recurring and this being fixable next time.
if [ ${#PATHS[@]} -gt 0 ]; then
  for _p in "${PATHS[@]}"; do
    if ! _sync_err=$(git add --all -- "$_p" 2>&1); then
      printf 'aios-commit: WARNING — post-commit index sync failed for: %s\n' "$_p" >&2
      [ -n "$_sync_err" ] && printf 'aios-commit:   git said: %s\n' "$_sync_err" >&2
      printf 'aios-commit:   Your commit SUCCEEDED; this only means the real index still holds\n' >&2
      printf 'aios-commit:   the old content for that path, so `git status` may show it as\n' >&2
      printf 'aios-commit:   modified indefinitely. Fix: git restore --staged -- <path>\n' >&2
    fi
  done
fi

# ...and the --untrack counterpart. Without this the real index still lists the file while
# HEAD says it is gone, so `git status` reads "AM" and the NEXT commit by any actor silently
# re-adds it — the untrack would not stick. Scoped to the named paths, --cached so the file
# stays on disk, inside the lock so it cannot race a sibling commit.
#
# -f is REQUIRED, not laziness: `git rm --cached` refuses a path whose staged content differs
# from BOTH the file and HEAD ("use -f to force removal") — the normal case here, since the file
# is typically modified-then-ignored while HEAD no longer carries it. Nothing is lost: --cached
# never touches the working tree, and keeping the file on disk is the entire point.
if [ ${#UNTRACK[@]} -gt 0 ]; then
  git rm --cached -rf --quiet --ignore-unmatch -- "${UNTRACK[@]}" 2>/dev/null || true
fi

# Did the index sync above actually take? Verify instead of assuming — the whole reason the
# stale-index bug survived is that the sync reported nothing either way. `git diff --cached` is
# safe here where `git add` was not: its pathspecs are permissive, so a path that no longer
# exists yields no output rather than a fatal. A stale index is cosmetic (the commit is correct)
# but it renders as `M`/`MM` forever, which is indistinguishable from real uncommitted work —
# and an operator who learns that `git status` cries wolf stops reading it. So: say it, don't fix
# it silently. Repairing the real index beyond the committed paths is exactly the shared-state
# overreach this tool exists to avoid.
if [ ${#PATHS[@]} -gt 0 ]; then
  STALE=$(git diff --cached --name-only HEAD -- "${PATHS[@]}" 2>/dev/null)
  if [ -n "$STALE" ]; then
    echo "aios-commit: NOTE — the commit is correct and complete, but your git index still lags HEAD for:" >&2
    printf '  %s\n' $STALE >&2
    echo "aios-commit: \`git status\` will show these as modified. Clear it with:  git reset -- <those paths>" >&2
  fi
fi

echo "aios-commit: ${COMMIT:0:9} — $(printf '%s' "$MSG" | head -1)"

# release the lock BEFORE the (slow, network) push so other commits don't wait on it
release; trap cleanup EXIT

# ── push-retry — never orphan, and never mis-name the cause ──
[ "$NO_PUSH" = 1 ] && exit 0
git remote | grep -q . || exit 0
git symbolic-ref --short HEAD >/dev/null 2>&1 || exit 0   # detached HEAD → skip push

PUSH_ERR=$(git push 2>&1); PUSH_RC=$?
if [ "$PUSH_RC" = 0 ]; then
  echo "aios-commit: pushed."
  rm -f "$PENDING"
else
  # Classify by whether the blocker is TRANSIENT (deferring genuinely self-heals)
  # or PERSISTENT (it does not, so name the action instead of promising a retry).
  # The old single message said "offline or remote diverged" for every failure —
  # a diagnosis asserted without ever reading the error. It sent two separate
  # sessions to investigate a divergence that did not exist while the real cause
  # was blocked egress, and it promised a self-heal that cannot happen inside a
  # sandbox, because the next aios-commit is sandboxed too.
  case "$PUSH_ERR" in
    *"peration not permitted"*|*"roxy"*"enied"* \
      |*"authentication method negotiation failed"*|*"Connection closed by UNKNOWN"*)
      # The last two are the SSH-through-a-sandbox-proxy signature. A sandboxed call
      # routes egress through a proxy that SSH cannot negotiate with, so `git push`
      # over git@ fails here even when the domain is allowlisted -- an allowlist entry
      # governs domains, not the ssh transport. Observed 2026-07-27; it previously fell
      # through to "cause not recognized", which is how it was found.
      echo "aios-commit: PUSH BLOCKED (no network egress) — $(git rev-parse --short HEAD) is committed locally but NOT pushed." >&2
      echo "aios-commit: this will NOT retry on its own in a sandboxed call. Either allow the git TRANSPORT host in the sandbox network allowlist (e.g. github.com — api.github.com is the REST host and does NOT cover git push), or re-run with network access: git -C \"$(pwd)\" push" >&2
      ;;
    *"ould not resolve host"*|*"etwork is unreachable"*|*"onnection timed out"*|*"ailed to connect"*)
      echo "aios-commit: push deferred — offline (transient). Retries on the next aios-commit or a manual push." >&2
      ;;
    *"rejected"*|*"non-fast-forward"*|*"etch first"*)
      echo "aios-commit: push rejected — the remote has diverged. Pull/rebase, then push. Commit is safe locally." >&2
      ;;
    *"ermission denied"*|*"publickey"*|*"uthentication failed"*)
      echo "aios-commit: push failed — authentication (ssh key / agent / token). Commit is safe locally." >&2
      ;;
    *)
      echo "aios-commit: push failed — cause not recognized; the git error follows. Commit is safe locally." >&2
      ;;
  esac
  printf '%s\n' "$PUSH_ERR" >&2
  # Durable marker so an unpushed commit is never invisible. /today, /close-session
  # and /close-day sweep this and retry the push with network access. Lives inside
  # .git/ so it is never committed and needs no ignore rule.
  date -u +%Y-%m-%dT%H:%M:%SZ > "$PENDING" 2>/dev/null || :
fi
exit 0
