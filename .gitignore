# === Root gitignore — applies across the whole AI-OS ===
# Keep this file as the single source of hygiene. Nested .gitignore files
# are only needed when a subdir has rules that genuinely can't live here.

# OS
.DS_Store
Thumbs.db
Desktop.ini
._*

# Python
**/.venv/
**/__pycache__/
*.pyc
*.pyo
**/*.egg-info/

# Node
**/node_modules/
**/package-lock.json

# IDE
.vscode/
.idea/

# Env + secrets — broad patterns prevent future leaks of OAuth / API keys
**/.env
**/.env.local
**/auth/
**/token.json
**/credentials.json
**/*oauth*.json
**/*secret*.json
**/*.key
**/auth_link.html
spotify-cache.json

# Runtime artifacts (regenerated each session)
hooks/pipeline-executor.log
**/.DS_Store

# Intentionally bundled shared OAuth app credentials (private repos only).
# Before shipping AI-OS as a public/open repo, rotate the client secret and
# remove this exception so each user creates their own OAuth app.
!mcps/google-workspace-mcp/oauth.json

# Obsidian workspace state (per-machine UI layout)
vault/.obsidian/workspace.json

# Google OAuth credentials — never commit; file ships as template, operator overwrites with real values locally
mcps/google-workspace-mcp/oauth.json

# Other credential files that should stay local
mcps/*/auth/*.json
mcps/*/storage_state.json
mcps/*/cookies.json
.slack-mcp-tokens.json
