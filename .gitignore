# === Root gitignore — applies across the whole AI-OS ===
# Keep this file as the single source of hygiene. Nested .gitignore files
# are only needed when a subdir has rules that genuinely can't live here.

# OS
.DS_Store
Thumbs.db
Desktop.ini
._*

# Python
**/.venv/
**/__pycache__/
*.pyc
*.pyo
**/*.egg-info/

# Node
**/node_modules/
**/package-lock.json

# IDE
.vscode/
.idea/

# Env + secrets — credential-file patterns only (not folder names — MCP source
# code uses auth/ folders for authentication MODULES which must stay tracked)
**/.env
**/.env.local
**/token.json
**/credentials.json
**/*oauth*.json
**/*secret*.json
**/*.key
**/auth_link.html
spotify-cache.json
**/storage_state.json
**/cookies.json
.slack-mcp-tokens.json

# Specific credential files (operator-local; ship as .template instead)
mcps/google-workspace-mcp/oauth.json

# Runtime artifacts (regenerated each session)
hooks/pipeline-executor.log
**/.DS_Store

# Obsidian workspace state (per-machine UI layout)
vault/.obsidian/workspace.json
