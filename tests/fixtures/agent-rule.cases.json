    "unclear": [
     {
      "path": "agents/custom/terse.md",
      "why": "no-description"
     }
    ]
   }
  },
  {
   "case": "a file whose name starts with _ is skipped, tag or not; README.md has no special standing",
   "files": {
    "agents/_index.md": [
