{
 "what": "Shared cases for one question: which files under `agents/` are agents. The rule: a `.md` file whose frontmatter `tags` include `agent`, and whose file name does not start with `_`.",
 "how_to_run": "For each case, create `files` under an empty folder (each value is the file's lines, joined with a newline, or with the case's `newline` when it gives one) and each entry of `links` as a symbolic link (link path to target, both relative to that folder; a target that does not exist is meant: the link is broken). Take that folder as the vault root, list its agents and compare with `expect.agents`, ordered by `path`: `name` and `path` always, `description` when the case gives one. `expect.unclear` is what the framework's lint reports (`list-agents.py --unclear --json`): a surface that has no such lint ignores it. A case with `surfaces_today` describes a known difference in the surfaces: skip it there, quoting the reason, until the surface is fixed.",
 "rule": "hooks/agents/list-agents.py states the rule and is the reference reading. tests/list-agents.test.sh runs it over every case.",
 "fields_read": "`tags` as a block list (`tags:` then `- item` lines) or inline (`tags: [a, b]` or `tags: a`), compared without regard to case. `name`, else the file name without `.md`. `description`, else empty. Outer quotes are removed; `''` inside single quotes and `\\\"` inside double quotes are unescaped.",
 "unclear_reasons": {
  "no-tag": "no `agent` tag, not under a `reference/` folder, not marked `agent: false`, and not README.md",
  "no-description": "tagged `agent`, with no `description`",
  "tagged-document": "tagged `agent` and also under `reference/` or marked `agent: false`; the tag wins"
 },
 "cases": [
  {
   "case": "a block-list tag makes an agent",
   "files": {
    "agents/acme/acme-lawyer.md": [
     "---",
     "name: acme-lawyer",
     "description: Reviews Acme contracts",
     "tags:",
     "  - agent",
     "  - sales",
     "---",
     "body"
    ]
   },
   "expect": {
    "agents": [
     {
      "name": "acme-lawyer",
      "path": "agents/acme/acme-lawyer.md",
      "description": "Reviews Acme contracts"
     }
    ],
    "unclear": []
   }
  },
  {
   "case": "an inline tag list, and a tag in another case",
   "files": {
    "agents/custom/a.md": [
     "---",
     "name: a",
     "description: Does a thing",
     "tags: [sales, agent]",
     "---",
     "body"
    ],
    "agents/custom/b.md": [
     "---",
     "name: b",
     "description: Does a thing",
     "tags: [Agent]",
     "---",
     "body"
    ],
    "agents/custom/c.md": [
     "---",
     "name: c",
     "description: Does a thing",
     "tags: agent",
     "---",
     "body"
    ]
   },
   "expect": {
    "agents": [
     {
      "name": "a",
      "path": "agents/custom/a.md"
     },
     {
      "name": "b",
      "path": "agents/custom/b.md"
     },
     {
      "name": "c",
      "path": "agents/custom/c.md"
     }
    ],
    "unclear": []
   }
  },
  {
   "case": "quoted items in an inline list, and a quoted list",
   "files": {
    "agents/custom/qi.md": [
     "---",
     "name: qi",
     "tags: ['agent', \"sales\"]",
     "---"
    ],
    "agents/custom/ql.md": [
     "---",
     "name: ql",
     "tags: \"[agent]\"",
     "---"
    ]
   },
   "expect": {
    "agents": [
     {
      "name": "qi",
      "path": "agents/custom/qi.md"
     },
     {
      "name": "ql",
      "path": "agents/custom/ql.md"
     }
    ],
    "unclear": [
     {
      "path": "agents/custom/qi.md",
      "why": "no-description"
     },
     {
      "path": "agents/custom/ql.md",
      "why": "no-description"
     }
    ]
   }
  },
  {
   "case": "Windows line endings",
   "newline": "\r\n",
   "files": {
    "agents/custom/crlf.md": [
     "---",
     "name: crlf",
     "description: Saved on Windows",
     "tags:",
     "  - agent",
     "---",
     "body"
    ]
   },
   "expect": {
    "agents": [
     {
      "name": "crlf",
      "path": "agents/custom/crlf.md",
      "description": "Saved on Windows"
     }
    ],
    "unclear": []
   }
  },
  {
   "case": "name and description without the tag is not an agent, and is reported",
   "files": {
    "agents/custom/handmade.md": [
     "---",
     "name: handmade",
     "description: Written by hand",
     "---",
     "body"
    ]
   },
   "expect": {
    "agents": [],
    "unclear": [
     {
      "path": "agents/custom/handmade.md",
      "why": "no-tag"
     }
    ]
   }
  },
  {
   "case": "a tag that only contains the word is not the tag",
   "files": {
    "agents/custom/x.md": [
     "---",
     "name: x",
     "description: Does a thing",
     "tags: [agents, subagent, agent-like]",
     "---",
     "body"
    ]
   },
   "expect": {
    "agents": [],
    "unclear": [
     {
      "path": "agents/custom/x.md",
      "why": "no-tag"
     }
    ]
   }
  },
  {
   "case": "no name: the file name is the name",
   "files": {
    "agents/custom/quiet-one.md": [
     "---",
     "description: Does a thing",
     "tags:",
