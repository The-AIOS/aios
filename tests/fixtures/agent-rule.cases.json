  },
  {
   "case": "documents: under reference/, or marked agent: false, are quiet",
   "files": {
    "agents/acme/reference/code-of-commerce.md": [
     "---",
     "name: code-of-commerce",
     "description: The law text",
     "---",
     "body"
    ],
    "agents/acme/glossary.md": [
     "---",
     "agent: false",
     "title: Glossary",
     "---"
    ],
    "agents/acme/reference/deep/note.md": [
     "plain"
    ]
   },
   "expect": {
    "agents": [],
    "unclear": []
   }
  },
  {
   "case": "a loose file with no tag and no document mark is reported",
   "files": {
    "agents/acme/example-case.md": [
     "no frontmatter, an example"
    ]
   },
   "expect": {
    "agents": [],
    "unclear": [
     {
      "path": "agents/acme/example-case.md",
      "why": "no-tag"
     }
    ]
   }
  },
  {
   "case": "the tag wins over a document mark, and the contradiction is reported",
   "files": {
    "agents/acme/reference/tagged.md": [
     "---",
     "name: tagged",
     "description: Does a thing",
     "tags:",
     "  - agent",
     "  - sales",
     "---",
     "body"
    ],
    "agents/acme/marked.md": [
     "---",
     "name: marked",
     "description: Does a thing",
     "agent: false",
     "tags:",
     "  - agent",
     "  - sales",
     "---",
     "body"
    ]
   },
   "expect": {
    "agents": [
     {
      "name": "marked",
      "path": "agents/acme/marked.md"
     },
     {
      "name": "tagged",
      "path": "agents/acme/reference/tagged.md"
     }
    ],
    "unclear": [
     {
      "path": "agents/acme/marked.md",
      "why": "tagged-document"
     },
     {
      "path": "agents/acme/reference/tagged.md",
      "why": "tagged-document"
     }
    ]
   }
  },
  {
