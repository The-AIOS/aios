{
  "what": "Shared cases for the daily note's `## Agents can handle` section: what `/today` writes, and what a surface must bind from it.",
  "how_to_run": "For each case, join `note` with newlines, give it to the surface's section parser, and compare with `expect`. `suggestions` is the ordered list of live, bindable lines: `task` is the label, `agents` the agents named after `agent:` (the first one is dispatched), `command` and `arg` are present only on a command-routed line. `count` is the badge. A case with `template` is that template line filled in; a case with `source` holds a line copied verbatim from that file.",
  "rule": "tests/fixtures/agents-can-handle-ref.py states the rule and is the reference reading.",
  "cases": [
    {
      "case": "today.md template, agent form, verbatim",
      "source": "plugins/aios/commands/today.md",
      "note": ["## Agents can handle", "- 🤖 {task} _(→ agent: [[agent-name]])_"],
      "expect": { "count": 1, "suggestions": [{ "task": "{task}", "agents": ["agent-name"] }] }
    },
    {
      "case": "today.md template, command form, verbatim: an unfilled placeholder is not a command",
      "source": "plugins/aios/commands/today.md",
      "note": ["## Agents can handle", "- 🤖 {task} _(→ command: `/aios:{command-name}`)_"],
      "expect": { "count": 0, "suggestions": [] }
    },
    {
      "case": "CLAUDE.md agent form, verbatim",
      "source": "CLAUDE.md",
      "note": ["## Agents can handle", "- 🤖 {task} _(→ agent: [[name]])_"],
      "expect": { "count": 1, "suggestions": [{ "task": "{task}", "agents": ["name"] }] }
    },
    {
      "case": "CLAUDE.md command form, verbatim: an unfilled placeholder is not a command",
      "source": "CLAUDE.md",
      "note": ["## Agents can handle", "- 🤖 {task} _(→ command: `/aios:{name}`)_"],
      "expect": { "count": 0, "suggestions": [] }
    },
    {
      "case": "agent template filled in",
      "template": "- 🤖 {task} _(→ agent: [[agent-name]])_",
      "note": ["## Agents can handle", "- 🤖 Draft the launch email _(→ agent: [[email-drafter]])_"],
      "expect": { "count": 1, "suggestions": [{ "task": "Draft the launch email", "agents": ["email-drafter"] }] }
    },
    {
      "case": "command template filled in",
      "template": "- 🤖 {task} _(→ command: `/aios:{command-name}`)_",
      "note": ["## Agents can handle", "- 🤖 Ingest the keynote _(→ command: `/aios:ingest`)_"],
      "expect": { "count": 1, "suggestions": [{ "task": "Ingest the keynote", "agents": [], "command": "/aios:ingest" }] }
    },
    {
      "case": "the template line, with its canonical task checked in another section, is done",
      "template": "- 🤖 {task} _(→ agent: [[agent-name]])_",
      "note": [
        "## Rhythm",
        "- [x] Draft the deck",
        "",
        "## Agents can handle",
        "- 🤖 Draft the deck _(→ agent: [[deck-builder]])_"
      ],
      "expect": { "count": 0, "suggestions": [] }
    },
    {
      "case": "the template line, with its canonical task struck in another section, is done",
      "template": "- 🤖 {task} _(→ agent: [[agent-name]])_",
      "note": [
        "## Rhythm",
        "- ~~Draft the deck~~ ✅",
        "",
        "## Agents can handle",
        "- 🤖 Draft the deck _(→ agent: [[deck-builder]])_"
      ],
      "expect": { "count": 0, "suggestions": [] }
    },
    {
      "case": "the template line, with its canonical task still open, counts",
      "template": "- 🤖 {task} _(→ agent: [[agent-name]])_",
      "note": [
        "## Rhythm",
        "- [ ] Draft the deck",
        "",
        "## Agents can handle",
        "- 🤖 Draft the deck _(→ agent: [[deck-builder]])_"
      ],
      "expect": { "count": 1, "suggestions": [{ "task": "Draft the deck", "agents": ["deck-builder"] }] }
    },
    {
      "case": "a command line with its canonical task checked elsewhere is done",
      "template": "- 🤖 {task} _(→ command: `/aios:{command-name}`)_",
      "note": [
        "## Rhythm",
        "- [x] Ingest the keynote",
        "",
        "## Agents can handle",
        "- 🤖 Ingest the keynote _(→ command: `/aios:ingest`)_"
      ],
      "expect": { "count": 0, "suggestions": [] }
    },
    {
      "case": "a project wikilink before the agent: the agent is the one after `agent:`",
      "template": "- 🤖 {task} _(→ agent: [[agent-name]])_",
      "note": ["## Agents can handle", "- 🤖 Draft [[acme-sales]] follow-up _(→ agent: [[content-writer]])_"],
      "expect": { "count": 1, "suggestions": [{ "task": "Draft [[acme-sales]] follow-up", "agents": ["content-writer"] }] }
    },
    {
      "case": "a project wikilink in a line routed to no agent binds nothing",
      "note": ["## Agents can handle", "- 🤖 Review the [[acme-sales]] pipeline _(→ me at close-day)_"],
      "expect": { "count": 0, "suggestions": [] }
    },
    {
      "case": "a wikilink in the route with no `agent:` before it binds nothing",
      "note": ["## Agents can handle", "- 🤖 Draft the deck _(→ [[deck-builder]])_"],
      "expect": { "count": 0, "suggestions": [] }
    },
    {
      "case": "a line with no route still needs `agent:` before the wikilink",
      "note": [
        "## Agents can handle",
        "- 🤖 Draft the deck → agent: [[deck-builder]]",
        "- 🤖 Draft the memo → [[content-writer]]"
      ],
      "expect": { "count": 1, "suggestions": [{ "task": "Draft the deck → agent: [[deck-builder]]", "agents": ["deck-builder"] }] }
    },
    {
      "case": "an aliased wikilink names the agent, not its display text",
      "note": ["## Agents can handle", "- 🤖 Draft the post _(→ agent: [[content-writer|Writer]])_"],
      "expect": { "count": 1, "suggestions": [{ "task": "Draft the post", "agents": ["content-writer"] }] }
    },
    {
      "case": "two agents after `agent:` are both listed, in order",
      "note": ["## Agents can handle", "- 🤖 Review the contract _(→ agent: [[lawyer]] / [[accountant]])_"],
      "expect": { "count": 1, "suggestions": [{ "task": "Review the contract", "agents": ["lawyer", "accountant"] }] }
    },
    {
      "case": "a command with its argument inside the backticks",
      "note": ["## Agents can handle", "- 🤖 Ingest the keynote _(→ command: `/aios:ingest https://example.com/talk`)_"],
      "expect": { "count": 1, "suggestions": [{ "task": "Ingest the keynote", "agents": [], "command": "/aios:ingest", "arg": "https://example.com/talk" }] }
    },
    {
      "case": "a command with a URL elsewhere on the line: the URL is its argument",
      "note": ["## Agents can handle", "- 🤖 Ingest https://example.com/talk _(→ command: `/aios:ingest`)_"],
      "expect": { "count": 1, "suggestions": [{ "task": "Ingest https://example.com/talk", "agents": [], "command": "/aios:ingest", "arg": "https://example.com/talk" }] }
    },
    {
      "case": "a command with a markdown link on the line: the link target is its argument",
      "note": ["## Agents can handle", "- 🤖 Ingest [the keynote](https://example.com/talk) _(→ command: `/aios:ingest`)_"],
      "expect": { "count": 1, "suggestions": [{ "task": "Ingest [the keynote](https://example.com/talk)", "agents": [], "command": "/aios:ingest", "arg": "https://example.com/talk" }] }
    },
    {
      "case": "a command line with no route (older notes) still binds",
      "note": ["## Agents can handle", "- 🤖 Ingest the keynote — `/aios:ingest` https://example.com/talk"],
      "expect": { "count": 1, "suggestions": [{ "task": "Ingest the keynote — `/aios:ingest` https://example.com/talk", "agents": [], "command": "/aios:ingest", "arg": "https://example.com/talk" }] }
    },
    {
      "case": "a backticked command in the task text does not beat the one after `command:`",
      "note": ["## Agents can handle", "- 🤖 Ingest what `/aios:today` listed _(→ command: `/aios:ingest`)_"],
      "expect": { "count": 1, "suggestions": [{ "task": "Ingest what `/aios:today` listed", "agents": [], "command": "/aios:ingest" }] }
    },
    {
      "case": "a backticked command in the task text of an agent line: the agent is dispatched",
      "note": ["## Agents can handle", "- 🤖 Summarize what `/aios:drift` found _(→ agent: [[consultant]])_"],
      "expect": { "count": 1, "suggestions": [{ "task": "Summarize what `/aios:drift` found", "agents": ["consultant"] }] }
    },
    {
      "case": "a bare /command with no backticks binds nothing",
      "note": ["## Agents can handle", "- 🤖 Ingest the keynote _(→ command: /aios:ingest)_"],
      "expect": { "count": 0, "suggestions": [] }
    },
    {
      "case": "backticked `spawn ingest` has no slash and binds nothing",
      "note": ["## Agents can handle", "- 🤖 Ingest the keynote _(→ visible `spawn ingest`)_"],
      "expect": { "count": 0, "suggestions": [] }
    },
    {
      "case": "backticked `ingest` has no slash and binds nothing",
      "note": ["## Agents can handle", "- 🤖 Ingest the keynote _(→ `ingest` session, idle)_"],
      "expect": { "count": 0, "suggestions": [] }
    },
    {
      "case": "prose routing binds nothing",
      "note": ["## Agents can handle", "- 🤖 Reports backfill _(→ me at close-day)_"],
      "expect": { "count": 0, "suggestions": [] }
    },
    {
      "case": "a bold label (older notes) is the task",
      "note": ["## Agents can handle", "- 🤖 **Draft the launch email** — for Tuesday _(→ agent: [[email-drafter]])_"],
      "expect": { "count": 1, "suggestions": [{ "task": "Draft the launch email", "agents": ["email-drafter"] }] }
    },
    {
      "case": "a bold label with its canonical task checked elsewhere is done",
      "note": [
        "- [x] Draft the launch email",
        "",
        "## Agents can handle",
        "- 🤖 **Draft the launch email** _(→ agent: [[email-drafter]])_"
      ],
      "expect": { "count": 0, "suggestions": [] }
    },
    {
      "case": "bold in the middle of the task text is not the label",
      "note": ["## Agents can handle", "- 🤖 Draft the **Q3** board deck _(→ agent: [[deck-builder]])_"],
      "expect": { "count": 1, "suggestions": [{ "task": "Draft the **Q3** board deck", "agents": ["deck-builder"] }] }
    },
    {
      "case": "a hyphen in the task text survives",
      "note": ["## Agents can handle", "- 🤖 Write the follow-up _(→ agent: [[email-drafter]])_"],
      "expect": { "count": 1, "suggestions": [{ "task": "Write the follow-up", "agents": ["email-drafter"] }] }
    },
    {
      "case": "an asterisk bullet is a list item too",
      "note": ["## Agents can handle", "* 🤖 Draft the post _(→ agent: [[content-writer]])_"],
      "expect": { "count": 1, "suggestions": [{ "task": "Draft the post", "agents": ["content-writer"] }] }
    },
    {
      "case": "a struck mirror line is done",
      "note": ["## Agents can handle", "- 🤖 ~~Draft the post~~ ✅ _(→ agent: [[content-writer]])_"],
      "expect": { "count": 0, "suggestions": [] }
    },
    {
      "case": "a checked line is done",
      "note": ["## Agents can handle", "- [x] 🤖 Draft the post _(→ agent: [[content-writer]])_"],
      "expect": { "count": 0, "suggestions": [] }
    },
    {
      "case": "a line stamped 🚀 is already with an agent",
      "note": ["## Agents can handle", "- 🤖 Draft the post _(→ agent: [[content-writer]])_ 🚀"],
      "expect": { "count": 0, "suggestions": [] }
    },
    {
      "case": "the section ends at the next `## ` heading; a `###` inside it does not end it",
      "note": [
        "## Rhythm",
        "- 🤖 Outside, before _(→ agent: [[consultant]])_",
        "",
        "## Agents can handle",
        "### Morning",
        "- 🤖 Inside the section _(→ agent: [[consultant]])_",
        "",
        "## Radar",
        "- 🤖 Outside, after _(→ agent: [[consultant]])_"
      ],
      "expect": { "count": 1, "suggestions": [{ "task": "Inside the section", "agents": ["consultant"] }] }
    },
    {
      "case": "a whole section as `/today` writes it: header and footer are prose, the count is the live bindable lines",
      "note": [
        "## Today I ship",
        "- [x] Send the board update",
        "- [ ] Draft [[acme-sales]] follow-up",
        "",
        "## Agents can handle",
        "🤖 **4 tasks agents can handle:**",
        "- 🤖 Draft [[acme-sales]] follow-up _(→ agent: [[content-writer]])_",
        "- 🤖 Ingest the keynote _(→ command: `/aios:ingest https://example.com/talk`)_",
        "- 🤖 Send the board update _(→ agent: [[email-drafter]])_",
        "- 🤖 Research the grant _(→ agent: [[researcher]])_ 🚀",
        "",
        "Say \"go with agents\" to spawn them all, or `/agent {name}` to wear the hat yourself in this session.",
        "",
        "## Radar"
      ],
      "expect": {
        "count": 2,
        "suggestions": [
          { "task": "Draft [[acme-sales]] follow-up", "agents": ["content-writer"] },
          { "task": "Ingest the keynote", "agents": [], "command": "/aios:ingest", "arg": "https://example.com/talk" }
        ]
      }
    }
  ]
}
